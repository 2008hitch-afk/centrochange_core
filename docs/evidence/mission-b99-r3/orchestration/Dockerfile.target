FROM frappe/erpnext:v16.50.0@sha256:833bceb57233908cbc949d7aa533942b18e54b329d846b933b66937c62b7e4ae

# Builder is fetched by its official release tag, then its immutable commit is asserted.
ARG BUILDER_TAG=v1.35.1
ARG BUILDER_REF=37e958bc4f801d06d0438c21b97b42c45c4eaa51
ARG HEALTHCARE_TAG=v16.6.1
ARG HEALTHCARE_REF=dda107b26e3a0fe1dbd65c7257371235de054a04

ENV NODE_OPTIONS="--max-old-space-size=1024 --dns-result-order=ipv4first" CMAKE_BUILD_PARALLEL_LEVEL=1 MAKEFLAGS=-j1

USER frappe
WORKDIR /home/frappe/frappe-bench

RUN --mount=type=cache,id=b99-r3-uv,target=/home/frappe/.cache/uv,uid=1000,gid=1000 --mount=type=cache,id=b99-r3-yarn,target=/home/frappe/.cache/yarn,uid=1000,gid=1000 --mount=type=cache,id=b99-r3-cypress,target=/home/frappe/.cache/Cypress,uid=1000,gid=1000 yarn config set network-concurrency 1 \
    && yarn config set network-timeout 600000 \
    && git config --global http.version HTTP/1.1 \
    && bench get-app --branch "${BUILDER_TAG}" builder https://github.com/frappe/builder.git \
    && test "$(git -C apps/builder rev-parse HEAD)" = "${BUILDER_REF}"

# Marley portal imports this public build-time setting from common_site_config.
RUN --mount=type=cache,id=b99-r3-uv,target=/home/frappe/.cache/uv,uid=1000,gid=1000 --mount=type=cache,id=b99-r3-yarn,target=/home/frappe/.cache/yarn,uid=1000,gid=1000 --mount=type=cache,id=b99-r3-cypress,target=/home/frappe/.cache/Cypress,uid=1000,gid=1000 bench set-config -gp socketio_port 9000 \
    && bench get-app --branch "${HEALTHCARE_TAG}" healthcare https://github.com/earthians/marley.git \
    && test "$(git -C apps/healthcare rev-parse HEAD)" = "${HEALTHCARE_REF}"

COPY --chown=frappe:frappe app/centrochange_core /home/frappe/frappe-bench/apps/centrochange_core

RUN uv pip install --no-cache --python /home/frappe/frappe-bench/env/bin/python --editable /home/frappe/frappe-bench/apps/centrochange_core \
    && printf '\n%s\n' centrochange_core >> sites/apps.txt \
    && bench build \
    && cp -a sites/assets/. assets/
