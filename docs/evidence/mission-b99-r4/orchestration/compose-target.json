{
  "name": "centrochange-b99-r4",
  "networks": {
    "centrochange-b99-r4-r4-fit-net": {
      "name": "centrochange-b99-r4-r4-fit-net",
      "driver": "bridge",
      "internal": true
    },
    "centrochange-b99-r4-r4-fit-http": {
      "name": "centrochange-b99-r4-r4-fit-http",
      "driver": "bridge"
    }
  },
  "services": {
    "r4-fit-backend": {
      "restart": "no",
      "command": null,
      "entrypoint": null,
      "environment": {
        "GUNICORN_THREADS": "2",
        "GUNICORN_TIMEOUT": "120",
        "GUNICORN_WORKERS": "1"
      },
      "image": "sha256:10e701947cccc377dc1d3c2082a03ef69b81d14da8e08fac75f07e78bcf974ce",
      "networks": {
        "centrochange-b99-r4-r4-fit-net": {
          "aliases": [
            "backend"
          ]
        }
      },
      "pull_policy": "never",
      "volumes": [
        {
          "type": "volume",
          "source": "centrochange-b99-r4-r4-fit-sites",
          "target": "/home/frappe/frappe-bench/sites",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "centrochange-b99-r4-r4-fit-assets",
          "target": "/home/frappe/frappe-bench/assets",
          "volume": {}
        }
      ],
      "depends_on": {
        "r4-fit-db": {
          "condition": "service_healthy"
        },
        "r4-fit-redis-cache": {
          "condition": "service_healthy"
        },
        "r4-fit-redis-queue": {
          "condition": "service_healthy"
        }
      },
      "mem_limit": "640m",
      "memswap_limit": "640m",
      "labels": {
        "centrochange.mission": "B99-R4"
      }
    },
    "r4-fit-db": {
      "restart": "no",
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--skip-character-set-client-handshake",
        "--innodb-buffer-pool-size=64M",
        "--table-open-cache=256",
        "--table-definition-cache=400"
      ],
      "entrypoint": null,
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${B99_DB_PASSWORD:?required}"
      },
      "image": "mariadb:11.8.8@sha256:24e76fcec8c003a0362d0dd53f4806e7e79458d7fdeaf47437760e19496f5a9c",
      "networks": {
        "centrochange-b99-r4-r4-fit-net": {
          "aliases": [
            "db"
          ]
        }
      },
      "volumes": [
        {
          "type": "volume",
          "source": "centrochange-b99-r4-r4-fit-db-data",
          "target": "/var/lib/mysql",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 10,
        "start_period": "2m0s"
      },
      "depends_on": {},
      "mem_limit": "512m",
      "memswap_limit": "512m",
      "labels": {
        "centrochange.mission": "B99-R4"
      }
    },
    "r4-fit-frontend": {
      "restart": "no",
      "command": [
        "nginx-entrypoint.sh"
      ],
      "entrypoint": null,
      "environment": {
        "BACKEND": "backend:8000",
        "FRAPPE_SITE_NAME_HEADER": "b99.local",
        "SOCKETIO": "websocket:9000",
        "UPSTREAM_REAL_IP_ADDRESS": "127.0.0.1",
        "UPSTREAM_REAL_IP_HEADER": "X-Forwarded-For",
        "UPSTREAM_REAL_IP_RECURSIVE": "off"
      },
      "image": "sha256:10e701947cccc377dc1d3c2082a03ef69b81d14da8e08fac75f07e78bcf974ce",
      "networks": {
        "centrochange-b99-r4-r4-fit-net": {
          "aliases": [
            "frontend"
          ]
        },
        "centrochange-b99-r4-r4-fit-http": {}
      },
      "pull_policy": "never",
      "volumes": [
        {
          "type": "volume",
          "source": "centrochange-b99-r4-r4-fit-sites",
          "target": "/home/frappe/frappe-bench/sites",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "centrochange-b99-r4-r4-fit-assets",
          "target": "/home/frappe/frappe-bench/assets",
          "volume": {}
        }
      ],
      "depends_on": {
        "r4-fit-backend": {
          "condition": "service_started",
          "required": true
        },
        "r4-fit-websocket": {
          "condition": "service_started",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8099",
          "protocol": "tcp"
        }
      ],
      "mem_limit": "32m",
      "memswap_limit": "32m",
      "labels": {
        "centrochange.mission": "B99-R4"
      }
    },
