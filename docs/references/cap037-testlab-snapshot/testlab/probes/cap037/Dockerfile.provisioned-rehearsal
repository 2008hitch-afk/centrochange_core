# Testlab-only CAP037 provisioning recipe. It is intentionally separate from
# centrochange_core's deploy recipe and therefore cannot change CAP040's result.
# The manifest target is the default. CAP037's isolated CURRENT baseline passes
# its own immutable source-definition base image through --build-arg.
ARG BASE_IMAGE=frappe/erpnext:v16.34.1@sha256:eee240a179ff494cb82ad067d853c8db3f87171d86324f4b326892654e342144
FROM ${BASE_IMAGE}

ARG BUILDER_TAG=v1.33.0
ARG BUILDER_REF=41987c064da4650e6901b5da82b7c76add452ebf
ARG HEALTHCARE_TAG=v16.5.2
ARG HEALTHCARE_REF=934d6c162868139dfbe80c23d6102adb7ec25adb

USER frappe
WORKDIR /home/frappe/frappe-bench

RUN bench set-config -gp socketio_port 9000 \
 && git config --global http.version HTTP/1.1 \
 && bench get-app --branch "${BUILDER_TAG}" builder https://github.com/frappe/builder.git \
 && test "$(git -C apps/builder rev-parse HEAD)" = "${BUILDER_REF}" \
 && bench get-app --branch "${HEALTHCARE_TAG}" healthcare https://github.com/earthians/marley.git \
 && test "$(git -C apps/healthcare rev-parse HEAD)" = "${HEALTHCARE_REF}"

COPY --chown=frappe:frappe app/centrochange_core /home/frappe/frappe-bench/apps/centrochange_core
RUN uv pip install --no-cache --python /home/frappe/frappe-bench/env/bin/python --editable /home/frappe/frappe-bench/apps/centrochange_core \
 && printf '\n%s\n' centrochange_core >> sites/apps.txt \
 && bench build --app builder --app healthcare --app centrochange_core \
 && git -C apps/builder restore --source="${BUILDER_REF}" --staged --worktree yarn.lock \
 && git -C apps/builder diff --exit-code \
 && git -C apps/builder diff --cached --exit-code \
 && git -C apps/healthcare diff --exit-code \
 && git -C apps/healthcare diff --cached --exit-code
