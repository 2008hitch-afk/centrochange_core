# DECISION-062 preparation only. Build and deployment require the specific Owner runtime gate.
# The preflight must assert this local tag resolves to
# sha256:6d6f9d2e65d0b16974e6b04aeaaf6d1210f071448ace5276689ebc9652bc2f7b.
FROM centrochange-single:issue75-form-affordance-r2

ARG PREMIUM_SOURCE_SHA
USER frappe
WORKDIR /home/frappe/frappe-bench

# Keep the pinned backend, DocTypes, role rules and accounting code.
# Overlay only DECISION-063 scoped API modules and versioned React files.
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/public/premium/ apps/centrochange_core/centrochange_core/public/premium/
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/www/premium.html apps/centrochange_core/centrochange_core/www/premium.html
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/www/premium.py apps/centrochange_core/centrochange_core/www/premium.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/www/premium-primo-incontro.html apps/centrochange_core/centrochange_core/www/premium-primo-incontro.html
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/www/premium_primo_incontro.py apps/centrochange_core/centrochange_core/www/premium_primo_incontro.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/catalog.py apps/centrochange_core/centrochange_core/catalog.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/scoped_api.py apps/centrochange_core/centrochange_core/scoped_api.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/operations/profiles.py apps/centrochange_core/centrochange_core/operations/profiles.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/finance/payments.py apps/centrochange_core/centrochange_core/finance/payments.py
COPY --chown=frappe:frappe app/centrochange_core/centrochange_core/finance/documents.py apps/centrochange_core/centrochange_core/finance/documents.py
COPY --chown=frappe:frappe infra/premium-single-stack-payload.json infra/premium-single-stack-payload.json
COPY --chown=frappe:frappe infra/premium_single_stack_package.py infra/premium_single_stack_package.py

RUN test -n "$PREMIUM_SOURCE_SHA" \
    && python infra/premium_single_stack_package.py --image /home/frappe/frappe-bench \
    && bench build --force \
    && cp -a sites/assets/. assets/ \
    && python infra/premium_single_stack_package.py --image /home/frappe/frappe-bench \
    && python -c "import json,pathlib; a=json.loads(pathlib.Path('assets/assets.json').read_text()); required={'desk.bundle.js','erpnext.bundle.js','healthcare.bundle.js','login.bundle.css','frappe-web.bundle.js'}; assert required <= a.keys(), sorted(required-a.keys())"

LABEL centrochange.issue="148" \
      centrochange.base_application_revision="e2fd728ecf6acdb0e0ab26379820df6905dd5521" \
      centrochange.premium_source="${PREMIUM_SOURCE_SHA}" \
      centrochange.payload_manifest="infra/premium-single-stack-payload.json" \
      centrochange.target="single-stack-react"
